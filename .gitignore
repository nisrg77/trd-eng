# Git ignore file for TEDENG
.env
venv/
model_weights/
__pycache__/
*.pyc
.pytest_cache/
*.keras
*.joblib
*.h5
frontend/node_modules/
.next/
*.log

# Scratch/debug scripts — never commit
scratch/
check_db.py
check_*.py

# Runtime state files — never commit (regenerated on startup)
signals_store.json
execution_store.json
simulated_account.json
decision_trace.jsonl
screener_targets.json
quota_state.json
goal.txt
*.png
/export_*.py
!research/rl/export_onnx.py
dstree.*

# Next.js build cache
frontend/.next/
frontend/tsconfig.tsbuildinfo
*.onnx
research/rl/runs/